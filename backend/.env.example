# MongoDB Atlas connection string (Database > Connect > Drivers in the
# Atlas dashboard). Include the database name at the end of the path.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/for-you?retryWrites=true&w=majority

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
FROM_ADDRESS="For You <no-reply@yourdomain.com>"
PORT=4000

# Comma-separated list of origins allowed to call this API.
# Leave blank to allow any origin (fine for a small personal project).
CORS_ORIGIN=
